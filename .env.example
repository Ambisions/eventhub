MYSQL_DATABASE=eventhub
MYSQL_USER=eventhub
MYSQL_PASSWORD=eventhub_local_password
MYSQL_ROOT_PASSWORD=eventhub_local_root_password

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

RABBITMQ_DEFAULT_USER=eventhub
RABBITMQ_DEFAULT_PASS=eventhub_local_password

# Base64-encoded random bytes; decoded length must be at least 32 bytes.
EVENTHUB_JWT_SECRET_BASE64=<BASE64_ENCODED_RANDOM_SECRET_AT_LEAST_32_BYTES>
